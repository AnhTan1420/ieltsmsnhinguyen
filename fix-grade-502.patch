+ */
+function extractGroqRetryDelayMs(err: any): number | null {
+  const headerVal = err?.headers?.["retry-after"] ?? err?.headers?.get?.("retry-after");
+  const headerSec = parseFloat(String(headerVal ?? ""));
+  if (Number.isFinite(headerSec)) return Math.ceil(headerSec * 1000);
+
+  const m = String(err?.message ?? "").match(/try again in\s+(?:(\d+)m)?\s*([\d.]+)(ms|s)/i);
+  if (!m) return null;
+  const minutes = m[1] ? parseInt(m[1], 10) : 0;
+  const value = parseFloat(m[2]);
+  if (!Number.isFinite(value)) return null;
+  const ms = m[3].toLowerCase() === "ms" ? value : value * 1000;
+  return Math.ceil(minutes * 60_000 + ms);
